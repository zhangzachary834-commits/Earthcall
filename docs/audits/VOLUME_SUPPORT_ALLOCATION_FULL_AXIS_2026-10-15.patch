+VolumeZeroProof buildVolumeZeroProof(const OntoMath::Piecewise& density,
+                                     const glm::vec3& halfExtent,
+                                     uint32_t targetCells, float marginFraction) {
+    const auto half = glm::abs(halfExtent);
+    auto pilot = buildProofOnGrid(density, -half, half, targetCells, marginFraction);
+    if (!pilot.any() || pilot.provenCells == pilot.totalCells) return pilot;
+    // Reallocate only inside the conservative envelope of the EXISTING proof.
+    // This is no new expression theorem, pilot-invariance assumption or new
+    // traversal strategy. The complement is covered by pilot zero bits; the
+    // GPU nevertheless evaluates outside-grid samples exactly (parallel rays
+    // can still reach them). Both proofs depend on density revision + extent.
+    // Allocation hint only: repeated occupied slice masks suggest redundant
+    // grid resolution. Empty outer slices are ignored; no mathematical
+    // invariance is inferred. Every proposed full-axis cell is re-proved below.
+    int collapsed = -1; uint32_t bestRepeated = 1;
+    for (int axis=0; axis<3; ++axis) {
+        const int a=(axis+1)%3,b=(axis+2)%3;
+        std::vector<uint8_t> reference;
+        uint32_t repeated=0; bool matches=true;
+        for(uint32_t i=0;i<pilot.dims[axis];++i) {
+            std::vector<uint8_t> slice; bool occupied=false;
+            for(uint32_t v=0;v<pilot.dims[b];++v)for(uint32_t u=0;u<pilot.dims[a];++u) {
+                glm::uvec3 c(0);c[axis]=i;c[a]=u;c[b]=v;
+                const bool unknown=!pilot.proven(c.x,c.y,c.z);slice.push_back(unknown);occupied|=unknown;
+            }
+            if(!occupied)continue;
+            if(reference.empty())reference=std::move(slice);
+            else if(slice!=reference){matches=false;break;}
+            ++repeated;
+        }
+        if(matches && repeated>bestRepeated){collapsed=axis;bestRepeated=repeated;}
+    }
+    // The rejected isotropic focused grid is not the fallback.
+    if(collapsed<0)return pilot;
+    uint32_t transitions[3]={0,0,0};
+    for(uint32_t z=0;z<pilot.dims.z;++z)for(uint32_t y=0;y<pilot.dims.y;++y)for(uint32_t x=0;x<pilot.dims.x;++x) {
+        const glm::uvec3 c(x,y,z);const bool bit=pilot.proven(x,y,z);
+        for(int axis=0;axis<3;++axis)if(c[axis]+1<pilot.dims[axis]) {
+            auto n=c;++n[axis];transitions[axis]+=bit!=pilot.proven(n.x,n.y,n.z);
+        }
