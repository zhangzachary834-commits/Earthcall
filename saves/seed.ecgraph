# Earthcall Singular-Graph Seed
# A true ontological graph representation of a World Formation
# No nesting, no artificial IDs, just Lexemes, Singulars, and Relations.

[Formation "world-genesis"]
name = Genesis Zone
telos = lexeme.christ
author = Zach

[Singular "player-1"]
name = First Mover
telos = lexeme.human
position = 0, 1, 0

[Relation "owns"]
source = world-genesis
target = player-1

[Singular "shape-gen-tool"]
concept = concept.tool.shape_generator
activeShapeKind = 0
active3DMode = cube

[Relation "equipped"]
source = player-1
target = shape-gen-tool

[Relation "visibility"]
source = world-genesis
target = shape-gen-tool
state = true
