{
    "id": "compiler-law",
    "name": "Metalaw: Compile ECGraph to MsgPack",
    "authors": [
        "Zach"
    ],
    "enabled": true,
    "description": "Reads an .ecgraph file, compiles the Lexeme/Relation forms into JSON using CodecChannel, translates the JSON to MsgPack, and writes the binary .ecform.",
    "conditions": [
        {
            "kind": "OnBecomeTrue",
            "path": "@state.compiler.compileTrigger",
            "threshold": 0
        }
    ],
    "actionModel": {
        "kind": 5,
        "children": [
            {
                "kind": 23,
                "input": "@state.compiler.inputFile",
                "path": "@state.compiler.rawText"
            },
            {
                "kind": 25,
                "propertyName": "ecgraphToJson",
                "input": "@state.compiler.rawText",
                "path": "@state.compiler.jsonAst"
            },
            {
                "kind": 25,
                "propertyName": "jsonToMsgpack",
                "input": "@state.compiler.jsonAst",
                "path": "@state.compiler.msgpackBinary"
            },
            {
                "kind": 24,
                "input": "@state.compiler.msgpackBinary",
                "path": "@state.compiler.outputFile"
            },
            {
                "kind": 0,
                "path": "@state.compiler.compileTrigger",
                "input": false
            }
        ]
    }
}