// Earthcall.fbs - FlatBuffers schema for Earthcall physical serialization (.ecmatter)

namespace Earthcall.Schema;

// --- HYBRID SCHEMA: DYNAMIC LAWS ---
// The Law system uses arbitrary types. We map them into a generic key-value store.
enum PropertyType : byte {
  Int = 0,
  Float = 1,
  String = 2,
  Binary = 3,
  Bool = 4
}

table LawProperty {
  key: string;
  type: PropertyType;
  val_int: long;
  val_float: double;
  val_string: string;
  val_binary: [ubyte];
  val_bool: bool;
}

table LawComponent {
  name: string;
  properties: [LawProperty];
}

// --- HARDCODED SCHEMA: CORE ENGINE ---
// Optimized for zero-copy loading of giant arrays

struct Vec3 {
  x: float;
  y: float;
  z: float;
}

struct Vec4 {
  x: float;
  y: float;
  z: float;
  w: float;
}

table PolyhedronData {
  vertices: [Vec3];
  face_data: [int];
  face_offsets: [int];
}

table BezierPatch {
  du: int;
  dv: int;
  ctrl: [Vec3];
}

table FaceTexture {
  face_index: int;
  size: int;
  pixels: [ubyte];
}

table SmoothSurfaceData {
  closed: bool = true;
  orientable: bool = true;
  has_boundary: bool = false;
  is_volume: bool = false;
  model: int = 0; // 0 = Quadric, 1 = Parametric
  quadric_matrix: [float]; // 16 floats for 4x4 matrix
  quadric_form: int = 0; // 0=Sphere, 1=Ellipsoid, 2=CylinderSide, 3=ConeSide, 4=Paraboloid
  parametric_kind: int = 0; // 0=Torus, 1=Ovoid, 2=Mobius, 3=Klein, 4=ProjectivePlane
  axes: Vec3;
  z_trim_min: float = -0.5;
  z_trim_max: float = 0.5;
  params: [float];
}

table SdfNode {
  type: int;
  operation: int;
  transform: [float]; // 4x4 matrix
  planes: [Vec4];
  children_indices: [int];
  dims: Vec3;
  offset: Vec3;
  p0: float;
  p1: float;
  t: float;
  expr: string;
}

table FieldData {
  extent: Vec3;
  root_node: SdfNode;
}

// A generic "Entity" (could be a Zone, Person, or Prop)
table Entity {
  id: string;
  name: string;
  transform: [float];
  polyhedron: PolyhedronData;
  patch: BezierPatch;
  smooth_data: SmoothSurfaceData;
  field: FieldData;
  face_textures: [FaceTexture];
  face_colors: [Vec3];
  sdf_nodes: [SdfNode];
  
  // Dynamic components managed by the Law System
  laws: [LawComponent];

  material_id: string;
  center: Vec3;
  authoritative_axis: Vec3;
  target_rotation: Vec3;
  rotation_responsiveness: float = 1.0;
}

// A Save Chunk represents a spatial region or category of entities (.ecmatter)
table SaveChunk {
  chunk_id: string;
  entities: [Entity];
}

// The master state of the game
table GlobalState {
  world_name: string;
  timestamp: string;
  active_laws: [string];
  chunks: [string]; // List of chunk filenames to load
}

root_type SaveChunk;
